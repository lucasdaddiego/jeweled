{
  "name": "jeweled",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A polished match-3 puzzle game — Zen, Classic, Daily, Blitz, and Puzzles.",
  "license": "MIT",
  "author": "Lucas Daddiego",
  "homepage": "https://jeweled.daddiego.com.ar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasdaddiego/jeweled.git"
  },
  "scripts": {
    "serve": "npm run build && npx --yes serve dist",
    "build": "bash scripts/build.sh",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=jeweled",
    "audit:i18n": "bash scripts/i18n-audit.sh",
    "icons": "node scripts/build-icons.mjs",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node test-e2e/smoke.spec.mjs",
    "test:workers": "vitest run --config vitest.workers.config.js",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "html-minifier-terser": "7.2.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "vitest": "4.1.11",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=24.21.0 <25 || >=26.0.0"
  }
}
